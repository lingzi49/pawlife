/* 首页样式 */

/* 欢迎条 */
.greeting-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.greeting-avatar {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: #FFFBF5;
  border: 3rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-emoji { font-size: 56rpx; }
.greeting-bubble {
  background: #FFFBF5;
  border: 2rpx solid #E0D2B8;
  border-radius: 32rpx;
  padding: 14rpx 24rpx;
  flex: 1;
}
.greeting-text { font-size: 32rpx; font-weight: 600; color: var(--brown); }

/* 今日汪汪卡片 */
.today-card {
  background: #FFF3E0;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  border: 1rpx solid var(--border);
}
.today-card.urgent { background: #FFE0B2; border-color: #FFB74D; }
.today-card-left { flex-shrink: 0; padding-top: 4rpx; }
.today-card-icon { font-size: 44rpx; }
.today-card-body { flex: 1; min-width: 0; }
.today-card-title { font-weight: 700; font-size: 30rpx; color: var(--brown); margin-bottom: 8rpx; }
.today-subtitle { color: var(--muted); font-size: 24rpx; font-weight: 400; }
.today-card-text { font-size: 28rpx; color: var(--brown-light); line-height: 1.8; }
.today-card-text.urgent { color: var(--red); font-weight: 600; }
.today-card-action { margin-top: 12rpx; display: flex; gap: 10rpx; }
.action-badge {
  background: #FFCC80;
  color: #E65100;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.action-badge.supplement { background: #C8E6C9; color: #2E7D32; }
.today-card-refresh {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  border: 1rpx solid var(--border);
  background: rgba(255,255,255,0.6);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brown-light);
}

/* 暂停横幅 */
.suspend-banner {
  background: #FFEBEE;
  border: 2rpx solid #EF9A9A;
  border-radius: var(--radius);
  padding: 20rpx;
  margin-bottom: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #C62828;
  line-height: 1.6;
}
.suspend-banner button { margin-top: 14rpx; }

/* 档案卡片 */
.profile-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}
.profile-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.profile-mood-emoji { font-size: 40rpx; }
.profile-card-title-text { font-size: 32rpx; font-weight: 700; color: var(--brown); flex: 1; }
.profile-card-arrow { color: var(--muted); font-size: 28rpx; }
.profile-card-body { display: flex; flex-wrap: wrap; gap: 10rpx 28rpx; }
.profile-info-item { font-size: 28rpx; color: var(--brown-light); }
.info-strong { font-weight: 700; color: var(--brown); }
.profile-card-empty { text-align: center; padding: 20rpx 0; }
.empty-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.empty-text { color: var(--muted); font-size: 26rpx; margin-bottom: 16rpx; }

/* 功能入口网格 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.feature-card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx 20rpx;
  text-align: center;
  border: 1rpx solid var(--border);
  transition: transform 0.2s;
  flex: 1;
  min-width: calc(50% - 8rpx);
  max-width: calc(50% - 8rpx);
  box-sizing: border-box;
}
.feature-card:active { transform: scale(0.97); }
.feature-icon { font-size: 52rpx; display: block; margin-bottom: 10rpx; }
.feature-label { font-size: 30rpx; font-weight: 700; color: var(--brown); }
.feature-subtitle { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
