<!-- 饮食宝典页面 -->
<navbar title="饮食宝典" />

<view class="container">
  <!-- 暂停状态 -->
  <view class="suspend-banner" wx:if="{{suspended}}">
    <text>🚨 今日饮食建议已暂停。请优先联系兽医！</text>
    <button class="btn btn-sm btn-outline" bindtap="restoreSuggestions">已联系兽医，恢复建议</button>
  </view>

  <!-- 食谱卡片 -->
  <block wx:if="{{diet.ready}}">
    <view class="recipe-card">
      <!-- 装饰标题 -->
      <view class="recipe-deco">
        <view class="recipe-deco-line"></view>
        <view class="recipe-deco-title">🐶 {{diet.dog_name}}的一餐食谱</view>
        <view class="recipe-deco-line"></view>
      </view>
      <view class="recipe-date">📅 {{todayStr}}</view>
      <view class="recipe-meal-name">{{diet.meal_name}}</view>

      <!-- 食材清单 -->
      <view class="recipe-items">
        <view class="recipe-item" wx:for="{{diet.items}}" wx:key="name">
          <text class="recipe-item-emoji">{{item.emoji}}</text>
          <text class="recipe-item-name">{{item.name}}</text>
          <text class="recipe-item-weight">{{item.weight}}g</text>
        </view>
      </view>

      <!-- 总重 -->
      <view class="recipe-total">
        <text>⚖️ 本餐总重</text>
        <text class="recipe-total-weight">{{diet.total_weight}}g</text>
      </view>

      <!-- 营养标签 -->
      <view class="recipe-nutrition">
        <text class="nut-tag protein">🥩 蛋白质 {{diet.total_protein}}g</text>
        <text class="nut-tag fat">🧈 脂肪 {{diet.total_fat}}g</text>
        <text class="nut-tag carbs">🍚 碳水 {{diet.total_carbs}}g</text>
      </view>

      <view class="recipe-cooking-tip">💡 所有食材切碎蒸熟，不放盐哦～</view>

      <block wx:if="{{diet.allergy_note}}"><view class="recipe-warning allergy">{{diet.allergy_note}}</view></block>
      <block wx:if="{{diet.hypoglycemia_note}}"><view class="recipe-warning hypo">{{diet.hypoglycemia_note}}</view></block>
      <block wx:if="{{diet.disease_note}}"><view class="recipe-warning disease">{{diet.disease_note}}</view></block>

      <!-- 辅助信息 -->
      <view class="recipe-side-info">
        <view class="side-section">
          <view class="side-label">🔄 替换选择</view>
          <view class="side-text">🥩 {{diet.protein_options}}</view>
          <view class="side-text">🥬 {{diet.veggie_options}}</view>
          <view class="side-text">🍚 {{diet.carb_options}}</view>
        </view>
        <view class="side-section">
          <view class="side-label">🐟 鱼油补充</view>
          <view class="side-text">{{diet.fish_oil}}</view>
        </view>
        <view class="side-section">
          <view class="side-label">💡 小贴士</view>
          <view class="side-text">{{diet.tip}}</view>
        </view>
        <view class="side-heartfelt">💬 {{diet.heartfelt || '主人，照着这个喂我，我会长得壮壮、毛亮亮哦！'}}</view>
      </view>

      <!-- 免责声明 -->
      <view class="disclaimer-inline">
        📋 此饮食建议基于您填写的档案信息自动生成，仅供参考，不能替代兽医的专业诊断。如有健康问题请立即联系兽医。
      </view>
    </view>
  </block>

  <!-- 未准备好 -->
  <view class="empty-state" wx:if="{{!diet.ready && !suspended}}">
    <view style="font-size:64rpx;">🍖</view>
    <view>{{diet.message || '主人，请先完善我的档案（体重、生日）才能生成食谱哦～'}}</view>
  </view>
</view>
