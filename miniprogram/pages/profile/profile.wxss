/* 档案页样式 */

/* 照片区 */
.photo-area {
  position: relative;
  width: 180rpx; height: 180rpx;
  border-radius: 50%;
  margin: 0 auto 24rpx;
  overflow: hidden;
  border: 5rpx solid var(--border);
  background: #FDF8F2;
}
.profile-photo { width: 100%; height: 100%; }
.profile-photo-placeholder {
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}
.photo-camera {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  text-align: center;
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 0;
}

/* 信息网格 */
.info-grid { margin-bottom: 24rpx; }
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 28rpx;
}
.info-label { color: var(--brown-light); flex-shrink: 0; }
.info-value { color: var(--brown); font-weight: 600; text-align: right; }

/* 子菜单 */
.sub-menu {
  background: var(--card);
  border-radius: var(--radius);
  border: 1rpx solid var(--border);
  margin-bottom: 24rpx;
}
.sub-menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
  font-size: 30rpx;
  color: var(--brown);
}
.sub-menu-item:last-child { border-bottom: none; }
.sub-menu-item:active { background: #FFFBF5; }
.arrow { color: var(--muted); font-size: 24rpx; }

/* 建档表单 */
.modal-header { text-align: center; margin-bottom: 24rpx; }
.modal-logo { font-size: 72rpx; margin-bottom: 8rpx; }
.modal-title { font-size: 36rpx; font-weight: 700; color: var(--orange); margin-bottom: 8rpx; }
.modal-sub { color: var(--muted); font-size: 26rpx; line-height: 1.6; }
.picker-display {
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: #FFFAF2;
  font-size: 28rpx;
  color: var(--brown);
}
.disclaimer-box {
  background: #FFFBF5;
  border: 1rpx solid #FFE0C0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: var(--brown-light);
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.disclaimer-check {
  font-size: 28rpx;
  color: var(--brown);
  margin-bottom: 20rpx;
}
.disclaimer-check label { display: flex; align-items: center; gap: 8rpx; }

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(90, 58, 42, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.modal-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  max-width: 600rpx;
  width: 100%;
}
.edit-modal { max-width: 560rpx; }
.btn-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btn-row button { flex: 1; }
